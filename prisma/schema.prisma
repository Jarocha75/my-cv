// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  position    String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
}

model Skill {
  id       String @id @default(cuid())
  name     String
  category String // napr. "Frontend", "Backend", "Nástroje"
  level    Int    // 1 až 5
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  techStack   String[] 
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?  
  createdAt   DateTime @default(now())
}